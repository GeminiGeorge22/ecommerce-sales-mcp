{
  "name": "ecommerce-sales-mcp",
  "version": "0.2.0",
  "description": "Stdio MCP server: e-commerce sales signals: amazon bestsellers and reviews, ebay sold prices, tiktok shop, etsy sales via Apify's hosted MCP gateway",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ecommerce-sales-mcp": "src/server.js"
  },
  "main": "src/proxy.js",
  "files": [
    "src",
    "tools.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/env-guard.test.js test/proxy.test.js",
    "build:tools": "node scripts/build-tools.mjs",
    "check:tools": "node scripts/build-tools.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeminiGeorge22/ecommerce-sales-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "apify",
    "ecommerce",
    "sales-data",
    "bestsellers",
    "amazon",
    "ebay"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "mcpProxy": {
    "actors": [
      "junglee/amazon-bestsellers",
      "junglee/amazon-reviews-scraper",
      "caffein.dev/ebay-sold-listings",
      "unseenuser/TikTok-Shop-Scraper",
      "publicrecords/etsy-shop-velocity",
      "publicrecords/etsy-search-scraper"
    ]
  }
}
